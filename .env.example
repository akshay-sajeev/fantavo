# Copy to .env and fill in your own values: cp .env.example .env
#
# LEAGUE_ID is required. ESPN_S2 and SWID are only needed for private leagues --
# they are session cookies tied to your ESPN account, so treat them like
# passwords. Never commit .env or paste real values here.

LEAGUE_ID=
ESPN_S2=
SWID=

# DATABASE_URL is optional -- not a secret, just a local connection string.
# ingest/db.py defaults to postgresql:///fantavo_dev (a local Postgres
# instance over the Unix socket, peer auth, no password) if this is unset.
# See docs/decisions.md Phase 3 for how that database was set up.
DATABASE_URL=

# GEMINI_API_KEY is required for the AI league analyst (sim/api/analyst_view.py)
# to call the Gemini API -- treat it like a password, same as ESPN_S2/SWID
# above. Never commit .env or paste a real value here. Get one at
# https://ai.google.dev/gemini-api/docs/api-key. sim/api/app.py loads this
# repo-root .env automatically at startup (see sim/api/env.py) -- no need to
# `export` it yourself before running uvicorn.
GEMINI_API_KEY=

# CREDENTIAL_ENCRYPTION_KEY encrypts each connected user's ESPN espn_s2/SWID
# cookies at rest (Auth Phase B) -- treat it like a master password: anyone
# with this key can decrypt every stored credential. Never commit .env or
# paste a real value here. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# CRON_SECRET authenticates Vercel Cron Job requests to the two
# /internal/* endpoints (sim/api/app.py's require_cron_secret) -- Vercel
# does NOT set this itself. You must add it yourself as an environment
# variable in the Vercel project's settings; only then does Vercel send it
# back as `Authorization: Bearer <CRON_SECRET>` on every Cron-triggered
# request (see docs/decisions.md's Vercel Serverless Migration entry, and
# verify this exact header/scheme against Vercel's current docs before
# relying on it in production). If you skip setting it in Vercel, every
# Cron trigger will silently 401 forever. Only relevant for a Vercel
# deployment -- unset locally, local dev never calls these routes (the
# in-process scheduler in sim/api/scheduler.py runs instead).
CRON_SECRET=

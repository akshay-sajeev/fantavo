# Base URL of the sim FastAPI service (sim/api/app.py). No trailing slash.
SIM_API_URL=http://127.0.0.1:8123

# League id the root page ("/") redirects to. There is no league picker /
# auth flow yet (out of scope for Phase 5b) -- every page under
# /league/[leagueId] works for any ingested league id, real or synthetic.
DEFAULT_LEAGUE_ID=-1990001
